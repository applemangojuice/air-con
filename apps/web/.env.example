# --- Supabase (Settings → API). Leave unset for demo mode: the quote flow
# still works end-to-end, but nothing is persisted. The free tier is enough
# for the pilots; Pro is about $25/month if you outgrow it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Local data backend, used when Supabase isn't configured. "file" (the
# default outside production) keeps JSON per table plus uploaded files under
# LOCAL_DATA_DIR (default apps/web/.data, gitignored); "memory" forgets
# everything on restart (tests, throwaway demos); "none" forces the legacy
# no-database demo mode. Never use file/memory on serverless hosting: each
# instance would have its own data.
DATA_BACKEND=file
LOCAL_DATA_DIR=

# --- Sessions. Signs the sign-in cookie and local file URLs (HMAC-SHA256).
# Required in production (sign-in refuses to work without it); dev falls back
# to a fixed, public secret with a warning. Any long random string, e.g.
# `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=generate-a-long-random-string

# --- Staff sign-in (/login). Everyone signs in with an emailed magic link.
# ADMIN_EMAILS (comma separated): the first sign-in from one of these creates
# its admin account, so a fresh deployment can be bootstrapped.
ADMIN_EMAILS=you@example.com

# Break-glass: with OPS_PASSWORD set, /login also accepts an admin email plus
# this password (12-hour session, logged), for when email is down. Unset =
# magic links only. (It used to be a basic-auth wall; that's gone.)
OPS_PASSWORD=pick-something-strong

# "Try as…" DEMO accounts (one per role) on /login. Always on outside
# production; in production only with ALLOW_DEMO_LOGIN=1, for a demo
# deployment with nothing real in it. Never set it on the live business.
ALLOW_DEMO_LOGIN=

# --- Address autofill on the quote funnel (optional). Known addresses come
# from the Property Intelligence database first; getAddress.io fills the gaps
# for postcodes we haven't imported yet. Free tier at getaddress.io.
GETADDRESS_API_KEY=your-getaddress-key

# --- Quote emails via Resend (optional, quotes still save without this).
# All three must be set for emails to send. With Resend configured the team
# also gets a "new quote" alert on every submission and a "failed to save"
# alert if a lead ever can't be written, so nothing goes silently missing.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Dang, It's Hot <quotes@dang.ac>"
NEXT_PUBLIC_APP_URL=https://dang.ac

# Where new-lead and failed-to-save alerts go (optional). Defaults to the
# address EMAIL_FROM sends as.
LEADS_NOTIFY_EMAIL=you@dang.ac

# --- Abandoned-quote follow-up cron (optional). Vercel sends this as a
# bearer token when invoking /api/cron/follow-up (schedule in vercel.json);
# any random long string. Needs Resend configured to actually send.
CRON_SECRET=generate-a-long-random-string

# --- Video walkthrough pipeline (optional, videos still upload without these;
# records park at needs_review for manual handling).
OPENAI_API_KEY=sk-...            # Whisper transcription of walkthrough narration
ANTHROPIC_API_KEY=sk-ant-...     # Claude extraction: transcript -> structured floor plan

# --- EPC Open Data API (optional; only for scripts/fetch-epc.mjs and the
# "Load property data" GitHub Action's epc-api source). Free registration at
# https://epc.opendatacommunities.org/. In GitHub, add these as repo secrets.
EPC_API_EMAIL=you@example.com
EPC_API_KEY=your-epc-api-key

# --- SMS via Twilio (optional): survey and installer "on my way" texts,
# day-before reminders. Unset = demo mode: every SMS is rendered and stored in
# the outbox as "demo, not sent" (visible in /ops/messages), nothing leaves.
# TWILIO_FROM is an alphanumeric sender id (e.g. DangItsHot, no number to
# rent, one-way: every text includes our phone number) or a Twilio number in
# E.164. UK texts cost roughly 4-5p per message segment; check Twilio pricing.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=DangItsHot

# --- Card payments via Stripe Checkout (optional). Unset = demo mode: bank
# transfer recorded by hand, plus a clearly labelled "simulate payment" button
# outside production. sk_test_... = sandbox (test cards, no real money, the
# mode banner says TEST); sk_live_... = real money. Payments are only ever
# recorded from the verified webhook (an endpoint under /api/stripe/), never
# from the redirect. No monthly fee; UK cards are about 1.5% + 20p each.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
