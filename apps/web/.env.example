# --- Supabase (Settings → API). Leave unset for demo mode: the quote flow
# still works end-to-end, but nothing is persisted.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin console (/ops/*). Basic-auth password; unset = pages show a setup
# notice. In the browser: any username, this password.
OPS_PASSWORD=pick-something-strong

# --- Address autofill on the quote funnel (optional). Known addresses come
# from the Property Intelligence database first; getAddress.io fills the gaps
# for postcodes we haven't imported yet. Free tier at getaddress.io.
GETADDRESS_API_KEY=your-getaddress-key

# --- Quote emails via Resend (optional, quotes still save without this).
# All three must be set for emails to send.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Dang, It's Hot <quotes@dang.ac>"
NEXT_PUBLIC_APP_URL=https://dang.ac

# --- Video walkthrough pipeline (optional, videos still upload without these;
# records park at needs_review for manual handling).
OPENAI_API_KEY=sk-...            # Whisper transcription of walkthrough narration
ANTHROPIC_API_KEY=sk-ant-...     # Claude extraction: transcript -> structured floor plan

# --- EPC Open Data API (optional; only for scripts/fetch-epc.mjs and the
# "Load property data" GitHub Action's epc-api source). Free registration at
# https://epc.opendatacommunities.org/. In GitHub, add these as repo secrets.
EPC_API_EMAIL=you@example.com
EPC_API_KEY=your-epc-api-key
