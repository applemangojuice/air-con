# --- Supabase (Settings → API). Leave unset for demo mode: the quote flow
# still works end-to-end, but nothing is persisted.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Ops pages (/ops/quotes). Basic-auth password; unset = pages show a setup notice.
OPS_PASSWORD=pick-something-strong

# --- Quote emails via Resend (optional — quotes still save without this).
# All three must be set for emails to send.
RESEND_API_KEY=re_xxx
EMAIL_FROM="Breeze <quotes@yourdomain.co.uk>"
NEXT_PUBLIC_APP_URL=https://yourdomain.co.uk
