# Copy to apps/web/.env.local (or add each one in Vercel → Settings →
# Environment Variables). Every secret and key below is deliberately EMPTY:
# fill in your own. The app treats the old template values (anything like
# "generate-…", "your-…", "re_xxx", "sk_test_xxx") as not set, and the boot
# log and /ops/launch name any that are still there.
#
# Going live: docs/going-live.md is the checklist, /ops/launch its live twin.

# --- Supabase (Settings → API). Required for real customers: without it the
# site runs in demo mode (the quote flow works, nothing is saved). Then run
# every file in supabase/migrations in order, 0001 to 0010 (both 0006 files).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Local data backend, only for development or a throwaway demo, never on
# Vercel (each serverless instance would have its own files). "file" (the
# default outside production) keeps JSON per table plus uploads under
# LOCAL_DATA_DIR (default apps/web/.data, gitignored); "memory" forgets
# everything on restart; "none" forces the no-database demo mode.
# DATA_BACKEND=file
# LOCAL_DATA_DIR=

# --- Sessions (REQUIRED in production). Signs the sign-in cookie and upload
# links (HMAC-SHA256). Without it, or with anything under 32 characters,
# production signs nobody in. Generate it, don't type it:
#   openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=

# --- Staff sign-in (/login). Everyone signs in with an emailed magic link.
# ADMIN_EMAILS (comma separated, REQUIRED for the first sign-in): the first
# sign-in from one of these creates its admin account.
ADMIN_EMAILS=

# Break-glass (optional): with OPS_PASSWORD set, /login also accepts an
# ADMIN_EMAILS address plus this password (12-hour session, logged, rate
# limited), for when email is down. At least 20 characters, or it stays off:
#   openssl rand -base64 24
# Leave it unset for magic links only.
# OPS_PASSWORD=

# "Try as…" DEMO accounts (one per role) on /login. Always on outside
# production; in production only with ALLOW_DEMO_LOGIN=1, for a demo
# deployment with nothing real in it. Never set it on the live business.
# With Supabase connected it also needs DEMO_DEPLOYMENT=1, saying that
# database holds nothing real either (a demo admin can see and change
# everything).
ALLOW_DEMO_LOGIN=
DEMO_DEPLOYMENT=

# --- Email via Resend (REQUIRED before any real customer). It carries the
# sign-in links, the proposal email (the pre-contract information and the
# cancellation form, which must reach the customer on a durable medium), the
# contract copy and every customer update; without it a live deployment
# refuses to issue proposals. Verify the EMAIL_FROM domain in Resend first.
RESEND_API_KEY=
EMAIL_FROM=
# The live domain, with https:// (links in every email point here).
NEXT_PUBLIC_APP_URL=
# Where new-lead and failed-to-save alerts go (optional; defaults to EMAIL_FROM's address).
LEADS_NOTIFY_EMAIL=

# --- Scheduled jobs (REQUIRED). Vercel sends this as a bearer token to the
# crons in vercel.json: /api/cron/daily-ops (survey and day-before reminders,
# proposal expiry, outbox retries, aftercare), /api/cron/digest (the morning
# summary) and /api/cron/follow-up (abandoned quotes); /api/cron/outbox takes
# it too. Without it they all answer 401 and nothing runs. Generate it:
#   openssl rand -hex 32
CRON_SECRET=

# --- Card payments via Stripe Checkout (optional). Unset = bank transfer
# recorded by hand (plus a labelled "simulate payment" button outside
# production). sk_test_… is the sandbox (the mode banner says TEST), sk_live_…
# real money. Money is only ever recorded from the verified webhook: add an
# endpoint in Stripe → Developers → Webhooks at
#   https://<your-domain>/api/stripe/webhook
# for checkout.session.completed, checkout.session.async_payment_succeeded and
# checkout.session.async_payment_failed, and put its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMS via Twilio (optional): survey and installer "on my way" texts,
# day-before reminders. Unset = every SMS is rendered and stored in the outbox
# as "demo, not sent" (visible in /ops/messages). TWILIO_FROM is an
# alphanumeric sender id (e.g. DangItsHot: one-way, so every text includes
# our phone number) or a Twilio number in E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Address autofill on the quote funnel (optional). Known addresses come
# from the Property Intelligence database first; getAddress.io fills the gaps.
GETADDRESS_API_KEY=

# --- Video walkthrough pipeline (the iOS capture app; not part of the pilot).
# Its public endpoints answer 404 in production unless this is 1:
VIDEO_SURVEYS_ENABLED=
# With it on, videos still upload without the keys below and park at
# needs_review for manual handling; each record is processed once.
# Whisper transcription of the walkthrough narration:
OPENAI_API_KEY=
# Claude extraction: transcript -> structured floor plan:
ANTHROPIC_API_KEY=

# --- EPC Open Data API (optional; only for scripts/fetch-epc.mjs and the
# "Load property data" GitHub Action's epc-api source). Free registration at
# https://epc.opendatacommunities.org/. In GitHub, add these as repo secrets.
EPC_API_EMAIL=
EPC_API_KEY=
